# Local development only. Copy to .env and set a strong local password.
POSTGRES_DB=evercanon
POSTGRES_USER=evercanon
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_PORT=5432

# Host port published by the app container (maps to port 3000 inside it).
APP_PORT=3000

# DATABASE_URL for running tools on the host (e.g. Prisma migrate) against the
# published postgres port. If your password contains reserved URL characters,
# URL-encode them. The app container gets its own DATABASE_URL from
# docker-compose.yml using the `postgres` service name, not localhost.
DATABASE_URL=postgresql://evercanon:replace-with-a-long-random-local-password@localhost:5432/evercanon?schema=public

# Generate a random secret for signed visitor cookies. Never use this example value.
VISITOR_COOKIE_SECRET=replace-with-a-random-secret-at-least-32-bytes
