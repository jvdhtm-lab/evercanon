# Local development only. Copy to .env and set a strong local password.
POSTGRES_DB=evercanon
POSTGRES_USER=evercanon
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_PORT=5432

# Host port published by the app container (maps to port 3000 inside it).
APP_PORT=3000

# DATABASE_URL used when running tools on the host (e.g. `npm run db:migrate`)
# against the published postgres port. If your password contains reserved URL
# characters, URL-encode them. Inside Docker Compose the app and migrate
# services get their own DATABASE_URL that points at the `postgres` service.
DATABASE_URL=postgresql://evercanon:replace-with-a-long-random-local-password@localhost:5432/evercanon

# Generate a random secret for signed visitor cookies. Never use this example value.
VISITOR_COOKIE_SECRET=replace-with-a-random-secret-at-least-32-bytes

# Disposable database used by integration tests. It is created on demand and
# rebuilt (schema dropped) on every integration test run. Never point this at a
# database whose data you care about.
TEST_DATABASE_URL=postgresql://evercanon:replace-with-a-long-random-local-password@localhost:5432/evercanon_test
